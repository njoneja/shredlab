{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShredLab",
  "version": "0.1.0",
  "identifier": "dev.stemextractor.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShredLab",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../models/registry/htdemucs_6s/*": "models/htdemucs_6s/",
      "../../models/onnx/beat_this_final0.onnx": "models/beat_this_final0.onnx",
      "../public/THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    }
  }
}
